# Base URL exposed to users for environment links (must include port if non-standard)
BASE_PUBLIC_URL=http://localhost:8080

# Absolute host path mounted into VS Code containers (relative paths will not work).
# Examples: /home/user/project/workspaces or C:\Users\user\project\workspaces
WORKSPACE_ROOT=/absolute/path/to/workspaces

# Optional overrides (defaults match nginx template and application defaults)
# MANAGED_NETWORK_NAME=vscode-manager-net
# WORKSPACE_CONTAINER_ROOT=/workspaces
# VSCODE_IMAGE=gitpod/openvscode-server:latest
# VSCODE_CONTAINER_PORT=3000
# CONTAINER_NAME_PREFIX=vscode-env-
# ENV_LABEL_PREFIX=com.vscode-manager
# MAX_ENVIRONMENTS=10
